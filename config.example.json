{
  "listen": "127.0.0.1:20128",
  "log_level": "info",
  "forward_unknown": true,
  "rtk": {
    "enabled": true,
    "level": "routre",
    "min_bytes": 0,
    "max_bytes": 10485760,
    "scan_bytes": 524288,
    "budget_ms": 150
  },
  "cache": {
    "enabled": true,
    "max_entries": 4096,
    "ttl_seconds": 86400,
    "prefix_order": true,
    "max_bytes": 67108864,
    "canonical_keys": true,
    "sliding_ttl": true,
    "prompt_cache": false
  },
  "timeouts": {
    "candidate_seconds": 45,
    "request_seconds": 180,
    "header_seconds": 120,
    "extension_seconds": 45,
    "generation_seconds": 300
  },
  "persist": {
    "enabled": true,
    "interval_seconds": 60
  },
  "tiers": [
    {
      "name": "subscription",
      "providers": [
        {
          "name": "anthropic-sub",
          "kind": "anthropic",
          "base_url": "https://api.anthropic.com",
          "api_key_env": "ANTHROPIC_API_KEY",
          "models": [
            "claude-sonnet-4-5",
            "claude-opus-4-1"
          ]
        },
        {
          "name": "openai-sub",
          "kind": "openai",
          "base_url": "https://api.openai.com/v1",
          "api_key_env": "OPENAI_API_KEY",
          "models": [
            "gpt-5",
            "gpt-5-mini"
          ]
        }
      ]
    },
    {
      "name": "cheap",
      "providers": [
        {
          "name": "glm",
          "kind": "openai",
          "base_url": "https://api.z.ai/api/paas/v4",
          "api_key_env": "GLM_API_KEY",
          "models": [
            "glm-4.7"
          ]
        },
        {
          "name": "minimax",
          "kind": "openai",
          "base_url": "https://api.minimax.io/v1",
          "api_key_env": "MINIMAX_API_KEY",
          "models": [
            "MiniMax-M2.1"
          ]
        }
      ]
    },
    {
      "name": "free",
      "providers": [
        {
          "name": "iflow",
          "kind": "openai",
          "base_url": "https://api.iflow.cn/v1",
          "api_key_env": "IFLOW_API_KEY",
          "models": [
            "qwen3-coder"
          ]
        }
      ]
    }
  ]
}