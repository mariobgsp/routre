@startuml routre-arch
!theme plain
skinparam backgroundColor #0a0a0a
skinparam defaultFontColor #FFFFFF
skinparam defaultBackgroundColor #1a1a1a
skinparam shadowing false
skinparam roundCorner 12
skinparam rectangle {
  BackgroundColor #1a1a1a
  BorderColor #4a4a4a
  FontColor #FFFFFF
}
skinparam arrowColor #666666
skinparam arrowThickness 1.2
skinparam noteBackgroundColor #1f1f1f
skinparam noteBorderColor #4a4a4a
skinparam noteFontColor #CCCCCC
skinparam titleFontColor #FFFFFF
skinparam titleFontSize 16
skinparam packageBackgroundColor #0a0a0a
skinparam packageBorderColor #333333
skinparam packageFontColor #AAAAAA

title routre — The 9-MB gateway (10 MiB RAM, 10.6 MiB binary) — How it works & how efficient it is

left to right direction

package "Clients  (any OpenAI / Anthropic CLI)" #0a0a0a {
  rectangle "opencode" as OC #1a1a1a
  rectangle "Claude Code" as CC #1a1a1a
  rectangle "Codex" as CX #1a1a1a
  rectangle "Cursor" as CU #1a1a1a
}

rectangle "routre  127.0.0.1:20128\n— single Go binary, stdlib only —" as GW #111111 {
  rectangle "HTTP Gateway\nnet/http + SSE relay\n11 ms overhead" as HTTP #222222
  rectangle "RTK  90% filter\nheuristic, no LM, no DB\n12 filters" as RTK #2a1a1a
  rectangle "Cache  sha256 LRU\n512 entries / 1h / 8 MiB" as CACHE #1a222a
  rectangle "Router  tiers\nsubscription → cheap → free" as ROUTER #1a2a1a
  rectangle "Ledger  per-agent\ntokens / $ + saved" as LEDGER #1a1a1a
  rectangle "Dashboard  /ui\nloopback-only, <2 MiB" as UI #222222
}

package "Providers  (506 models via config.all.json)" #0a0a0a {
  rectangle "Tier 1  subscription\nopencode-go  26 models\nopencode-zen 62 models" as T1 #1a2a1a
  rectangle "Tier 2  cheap / fallback\nopenrouter 413 models\ngemini 4 models" as T2 #1a222a
  rectangle "Tier 3  free\ncommunity / local" as T3 #222222
}

OC --> HTTP
CC --> HTTP
CX --> HTTP
CU --> HTTP

HTTP --> RTK : "1. 23.4 KB tool_result"
RTK --> CACHE : "2. RTK → 2.3 KB\n91.5% tool tokens"
CACHE --> ROUTER : "3. sha256 key\n(prefix_order)"
ROUTER --> T1 : "4. try T1"
T1 --> T2 : "failover\n429/5xx/401"
T2 --> T3 : "failover"
T1 ..> LEDGER
CACHE ..> LEDGER : "hit → saved"
ROUTER ..> LEDGER
UI ..> LEDGER : "read"

note right of RTK
  **RTK efficiency (bench-gated)**
  • 91.5% aggregate tool tokens
  • 90.3% worst payload (tree-ls)
  • 91.3% payload (whole body)
  • window 500B–10 MiB
  • never grows, fail-open
  • `routre bench` fails if <90%
end note

note right of CACHE
  **Cache**
  • exact-match, post-RTK
  • non-streaming only
  • prefix_order → stable keys
  • hit credited with upstream
    prompt tokens (billing-accurate)
end note

note right of ROUTER
  **Failover**
  • tiers in order
  • exp. cooldown 2s → 30m
  • 500ms retry same provider
  • Retry-After honored
  • streaming: only before
    1st byte (no dup)
end note

note bottom of GW
  **Efficiency at a glance — measured (scripts/measure-ram.sh)**
  Idle RSS: 10 MiB  (was 9 MiB pre-UI)  ≤100 MiB budget
  Peak (3 sessions): 12.9 MiB  ≤200 MiB
  Binary: 10.6 MiB  (CGO_ENABLED=0, -s -w)  was 6.7 MiB
  Dashboard delta: +0.2 MiB after serving /ui once  (<2 MiB)
  Overhead: ~11 ms per request
end note

@enduml
