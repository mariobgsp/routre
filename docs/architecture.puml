@startuml routre-arch
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #000000
skinparam defaultBackgroundColor #FAFAFA
skinparam shadowing false
skinparam roundCorner 8
skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #4A6FA5
  FontColor #000000
  FontSize 12
}
skinparam arrowColor #666666
skinparam arrowThickness 1.2
skinparam noteBackgroundColor #FFF8E1
skinparam noteBorderColor #D4A017
skinparam noteFontColor #333333
skinparam noteFontSize 11
skinparam titleFontColor #000000
skinparam titleFontSize 18
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageFontColor #333333
skinparam PackageTitleFontSize 14
skinparam nodesep 60
skinparam ranksep 80

title routre v0.3.2 — LLM API Gateway Architecture (OpenAI / Anthropic / Gemini compatible)

left to right direction

' =================== CLIENTS ===================
package "Clients — any OpenAI / Anthropic / Gemini compatible tool" {
  rectangle "opencode" as OC
  rectangle "Claude Code" as CC
  rectangle "Codex" as CX
  rectangle "Cursor" as CU
  rectangle "opencode-go CLI" as OCLI
}

' =================== GATEWAY ===================
package "routre — single Go binary, stdlib only — 127.0.0.1:20128" {
  rectangle "HTTP Server\nnet/http + SSE\n11 ms overhead" as HTTP

  package "Request Pipeline  (Pipeline struct)" {
    rectangle "Format detect\nOpenAI / Anthropic /\nResponses API" as FMT
    rectangle "RTK  12 filters\n≥90% tool tokens\nno LM, no DB, fail-open" as RTK
    rectangle "Cache  sha256 LRU\n512 entries / 1h / 8 MiB\nexact + streaming replay" as CACHE
    rectangle "Router.Candidates\ntiers · cooldown · refresh\n+ probe data" as ROUTER
    rectangle "candidateRunner\nretry · auth-refresh\nEmitted contract\n[internal/proxy/runner.go]" as RUNNER
    rectangle "dialect.Stream\nOpenAI ↔ Anthropic\nSSE state machine" as DIALECT
    rectangle "Dialect + relay\nhttp.Transport tuned\nMaxConns=64, H2,\nDisableCompression\n+ firstByteTimeout 30s" as RELAY
    rectangle "failures module\n503 / 404 / 502\nenriched per-provider" as FAIL
  }

  package "Observability" {
    rectangle "reqlog  JSONL\ndial_ms · headers_ms\nttfb_ms · total_ms\nstream abort preserved" as REQLOG
    rectangle "metrics  Prometheus\nrequests · cache\nfailures · tokens" as METRICS
    rectangle "probe  periodic\nper-provider p50\n[survey #3 follow-on]" as PROBE
    rectangle "doctor  one-shot\nCLI status check" as DOCTOR
  }

  package "Persistence" {
    database "Cache\nLRU + streaming" as CACHEDB
    database "Usage\ntokens / cost\nper-client" as USEDB
    database "Key store\nin-memory + fsync" as KEYDB
  }

  rectangle "Dashboard  /ui\nloopback-only" as UI
}

' =================== PROVIDERS ===================
package "Providers — 506 models (config.all.json)" {
  rectangle "Tier 1  subscription\nopencode-go  26\nopencode-zen 62" as T1
  rectangle "Tier 2  fallback\nopenrouter 413\ngemini 4" as T2
  rectangle "Tier 3  free\ncommunity / local" as T3
}

' =================== FLOWS ===================
OC    --> HTTP : "POST /v1/chat/completions"
CC    --> HTTP
CX    --> HTTP
CU    --> HTTP
OCLI  --> HTTP
HTTP  --> FMT
FMT   --> RTK
RTK   --> CACHE : "post-RTK body"
CACHE --> ROUTER : "cache miss\n→ candidates"
ROUTER --> RUNNER : "for each cand"
RUNNER --> DIALECT : "translate if\ncross-kind"
DIALECT --> RELAY
RELAY --> T1 : "try T1"
T1    --> T2 : "429/5xx/401"
T2    --> T3
RELAY --> HTTP : "SSE frames"
HTTP  --> OC : "stream + flush"
HTTP  --> CACHEDB : "write hit"
HTTP  --> USEDB : "recordFull"
HTTP  --> KEYDB : "on 401"
CACHE --> CACHEDB
RUNNER ..> FAIL : "all-failed\n→ 503 w/ tryLog"
RELAY ..> REQLOG : "t0 / t1 /\nfirst body"
REQLOG ..> METRICS

UI    ..> USEDB : "read"
UI    ..> CACHEDB : "read"
DOCTOR ..> T1 : "probe"
DOCTOR ..> T2 : "probe"
PROBE  ..> T1 : "background"
PROBE  ..> T2 : "background"

' =================== ANNOTATIONS ===================
note right of RTK
  **RTK efficiency** (bench-gated)
  · 91.5% aggregate tool tokens
  · 90.3% worst payload (tree-ls)
  · window 500B – 10 MiB
  · never grows, fail-open
  · `routre bench` fails if <90%
end note

note right of CACHE
  **Cache**
  · exact-match, post-RTK
  · non-streaming + streaming replay
  · prefix_order → stable keys
  · hit credited upstream
    prompt tokens (billing-accurate)
end note

note right of RUNNER
  **candidateRunner** (v0.3.2)
  · 1 + retryTransientAttempts attempts
  · transientRetryDelay 500ms
  · auth-refresh-and-retry (1 free)
  · ErrClient → no retry
  · Emitted=true → no failover
  · 11 unit tests
end note

note right of RELAY
  **http.Transport** (latency survey #1)
  · MaxConnsPerHost: 64
  · MaxIdleConnsPerHost: 32
  · IdleConnTimeout: 120s
  · DisableCompression: true
  · ForceAttemptHTTP2: true
  · firstByteTimeout: 30s
    (kills p99 stuck providers)
end note

note right of FAIL
  **failures.Outcome**
  · provider, kind, class
  · err, cooldown_remaining
  · 3 render funcs (wire + human)
  · 6 surface call sites
end note

note right of REQLOG
  **Per-phase observability**
  · dial_ms    (proxy prep)
  · headers_ms (upstream headers)
  · ttfb_ms    (first body byte)
  · total_ms   (whole attempt)
  · latency_ms kept for back-compat
end note

note bottom of HTTP
  **Efficiency — measured (scripts/measure-ram.sh)**
  Binary: 10.6 MiB  (CGO_ENABLED=0, -s -w)
  Idle RSS: 10 MiB    Peak (3 sessions): 12.9 MiB
  Overhead: ~11 ms per request
  Tests: 18 packages, runner has 11 unit tests
end note

@enduml
