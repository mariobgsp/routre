@startuml routre-arch
' Plain-English reading guide (for everyone):
' Your app talks to ONE address (routre on your computer).
' routre picks a healthy provider, shrinks waste, remembers repeats.
' If a provider fails, it tries the next - you just get the answer.
' Render: make diagrams (kroki.io + rsvg-convert, see Makefile)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1A1A1A
skinparam shadowing false
skinparam roundCorner 8
skinparam rectangleBackgroundColor #FAFAFA
skinparam rectangleBorderColor #4A6FA5
skinparam rectangleFontColor #000000
skinparam rectangleFontSize 12
skinparam arrowColor #555555
skinparam arrowThickness 1.3
skinparam noteBackgroundColor #FFF8E1
skinparam noteBorderColor #D4A017
skinparam noteFontColor #333333
skinparam noteFontSize 11
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageFontColor #333333
skinparam PackageTitleFontSize 13
skinparam nodesep 55
skinparam ranksep 75

title routre - one address, every provider (system overview)

note as PlainEnglish
  **For everyone:**
  1 your app points at one address
  2 routre picks a healthy provider
  3 shrinks repeat tool text (saves cost)
  4 remembers identical answers (cache)
  5 one provider down? it fails over
end note

left to right direction

' =================== CLIENTS ===================
package "Clients - any OpenAI / Anthropic / Gemini / Responses tool" as CL {
  rectangle "opencode" as OC #E8F0FE
  rectangle "Claude Code" as CC #E8F0FE
  rectangle "Codex" as CX #E8F0FE
  rectangle "Cursor / any SDK" as CU #E8F0FE
}

' =================== GATEWAY ===================
package "routre - one Go binary (stdlib only) - 127.0.0.1:20128" as GW {

  rectangle "HTTP Server\nnet/http + SSE flush" as HTTP #E3F2FD

  package "Pipeline (proxy.Pipeline)" as PIPE {
    rectangle "1  Format detect\nchat / messages / gemini\n/ responses (native)" as FMT #FFFFFF
    rectangle "2  RTK\n11 heuristic filters, no LM,\nfail-open, never grows" as RTK #FFF3E0
    rectangle "3  Prefix order + key\nv2:sha256(canonical JSON)\nof the processed body" as KEY #FFFFFF
    rectangle "4  Cache\n16k / 7d / 128 MiB,\nsliding TTL, SSE-safe" as CACHE #E8F5E9
    rectangle "5  Router\ntiered candidates,\ncooldown 2s -> 5m" as ROUTER #F3E5F5
    rectangle "6  candidateRunner\n30s per candidate,\n30s per request" as RUNNER #FFEBEE
    rectangle "7  Dialect + relay\ncross-kind translate,\nSSE per-frame flush" as RELAY #FFFDE7
  }

  package "Observability" as OBS {
    rectangle "reqlog  JSONL\ndial / headers /\nTTFB / total" as REQLOG #FAFAFA
    rectangle "GET /metrics\ntokens, cache,\nfailures" as METRICS #FAFAFA
    rectangle "GET /v1/status\nper-provider class +\ncooldown left" as STATUS #FAFAFA
  }

  package "Persistence (memory + files)" as PERS {
    database "Cache store\nLRU + captured SSE" as CACHEDB #E8F5E9
    database "Usage ledger\n~/.routre/usage.json" as USEDB #E3F2FD
    database "Keystore\nroutre.env (0600)" as KEYDB #FFF3E0
  }
}

' =================== PROVIDERS ===================
package "Providers - config tiers, tried in order" as PROV {
  rectangle "Tier 1  subscription\nopencode-go, opencode-zen" as T1 #E8F5E9
  rectangle "Tier 2  fallback\nopenrouter, gemini" as T2 #FFF3E0
  rectangle "Tier 3  free / local\ncommunity models" as T3 #F3E5F5
  rectangle "Model IDs are discovered\nlive, every 6h, and\npersisted back to config" as DISC #FAFAFA
}

' =================== FLOWS ===================
OC  --> HTTP : "POST /v1/chat/completions\n/v1/messages /v1/responses"
CC  --> HTTP
CX  --> HTTP
CU  --> HTTP
HTTP --> FMT
FMT --> RTK
RTK --> KEY
KEY --> CACHE
CACHE --> ROUTER : "miss -> candidates\nhit -> replay"
ROUTER --> RUNNER
RUNNER --> RELAY
RELAY --> T1 : "try tier 1"
T1 --> T2 : "5xx / 429 / 401\n-> next candidate"
T2 --> T3
RELAY --> HTTP : "SSE / JSON\n+ usage tokens"
HTTP --> OC : "X-Llrouter-Cache: hit"

CACHE ..> CACHEDB : "GetWithReason / Put"
HTTP ..> USEDB : "Record tokens + cost"
RUNNER ..> KEYDB : "auth fail -> refresh,\n1 free retry"
RUNNER ..> REQLOG
RELAY ..> REQLOG
REQLOG ..> METRICS
METRICS ..> STATUS
DISC ..> T1 : "GET {base}/models"
DISC ..> T2

note bottom of RUNNER
  **Failover is bounded**
  . 30 s to choose, 30 s per candidate
  . 5xx / 429 -> next candidate at once
    (an identical retry cannot change it)
  . connection error -> 1 retry, same provider
  . 401 / 403 -> re-read routre.env, 1 retry
  . bytes already flushed -> no failover
    (the client must not see output twice)
end note

note bottom of CACHE
  **Exact match on the processed body**
  . the key ignores the stream flag, so a
    JSON capture is never replayed as SSE
  . a hit credits the stored upstream prompt
    tokens, so the saving is billing-honest
  . miss reasons: disabled, absent, expired,
    shape_mismatch
end note

note bottom of RELAY
  **Tuned transport**
  MaxConnsPerHost 64, IdleConnTimeout 120 s,
  HTTP/2 forced. The first byte must land inside
  the attempt budget; after that a generation may
  run to a 5 min backstop.
end note

note bottom of RTK
  **Bench-gated**
  `go run . bench -target 90` runs in CI:
  the token savings must stay at or above 90%
  for every shape, or the build fails.
end note

@enduml
