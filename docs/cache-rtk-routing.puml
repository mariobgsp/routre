@startuml routre-internals
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1A1A1A
skinparam shadowing false
skinparam roundCorner 8
skinparam rectangleBackgroundColor #FAFAFA
skinparam rectangleBorderColor #4A6FA5
skinparam rectangleFontColor #000000
skinparam rectangleFontSize 11
skinparam arrowColor #555555
skinparam arrowThickness 1.2
skinparam noteBackgroundColor #FFF8E1
skinparam noteBorderColor #D4A017
skinparam noteFontColor #333333
skinparam noteFontSize 10
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #999999
skinparam packageFontColor #333333
skinparam PackageTitleFontSize 13
skinparam nodesep 50
skinparam ranksep 65

title routre - RTK, cache and tiered routing, inside the pipeline

left to right direction

' =================== RTK ===================
package "RTK - 11 heuristic filters, no LM and no network" as RTK_PKG {
  rectangle "Autodetect\nscore the first 1 KiB,\napply the best filter" as DETECT #FFF3E0
  rectangle "git-diff\ngit-log\ngit-status" as F1 #FFFFFF
  rectangle "grep\nfind\nls\ntree" as F2 #FFFFFF
  rectangle "read-numbered\nsearch-list\ndedup-log" as F3 #FFFFFF
  rectangle "build-output" as F4 #FFFFFF
  rectangle "smart-truncate\nfallback when no filter\nmatches" as F5 #FFFFFF
  rectangle "routre level\nblank lines out, repeated\nruns collapsed, head+tail" as F6 #FFFFFF
  rectangle "Envelope guard\nnever-grow: a bigger result\nis thrown away, and the\nsaved-token metric with it" as GUARD #FFEBEE
  DETECT --> F1
  DETECT --> F2
  DETECT --> F3
  DETECT --> F4
  DETECT --> F5
  F1 --> F6
  F2 --> F6
  F3 --> F6
  F4 --> F6
  F5 --> F6
  F6 --> GUARD
}

' =================== CACHE ===================
package "Cache - exact match on the processed body" as CACHE_PKG {
  rectangle "Prefix order\nsystem messages first,\nso the shared prefix is\nstable upstream" as PREFIX #E8F5E9
  rectangle "Key\nv2: + sha256(canonical JSON)\nthe stream flag is\ndropped before hashing" as KEY #E8F5E9
  rectangle "Lookup\nGetWithReason ->\nhit or a miss reason" as LOOKUP #FFFFFF
  rectangle "Store\nLRU 16384 entries,\n7d TTL sliding on,\n128 MiB, 8 MiB per entry" as STORE #FFFFFF
  rectangle "Streaming capture\nframes kept and replayed\nbyte-identical" as STREAM #E3F2FD
  rectangle "Billing\na hit credits the stored\nupstream prompt tokens" as BILL #FFFDE7
  PREFIX --> KEY
  KEY --> LOOKUP
  LOOKUP --> BILL
  LOOKUP --> STREAM
  STREAM --> STORE
}

' =================== ROUTING ===================
package "Router - ordered tiers, cooldown, bounded failover" as ROUTE_PKG {
  rectangle "Tiers\nconfig order, then the\nconfigured fallbacks list" as TIERS #F3E5F5
  rectangle "forward_unknown\ntrue by default: an unknown\nmodel tries every tier" as FWD #FFFFFF
  rectangle "Cooldown\n2s base, exponential,\n5 min cap, success resets" as COOL #FFEBEE
  rectangle "Retry-After\nhonoured as the floor,\ncapped at 30s" as RA #FFFFFF
  rectangle "Classes\nclient / auth / credits /\noverloaded / timeout /\nnetwork" as CLASS #FFFFFF
  rectangle "candidateRunner\n30s per request and per\ncandidate, 1 network retry,\n1 auth refresh, Emitted guard" as RUNNER2 #FFF3E0
  rectangle "Discovery\nGET {base}/models every 6h\n(+/- 5m jitter), persisted\nadditively" as PROBE2 #E3F2FD
  TIERS --> FWD
  FWD --> COOL
  COOL --> RA
  RA --> CLASS
  CLASS --> RUNNER2
  PROBE2 ..> TIERS
}

' ============ CROSS LINKS ============
GUARD ..> KEY : "processed body\nfeeds the key"
STORE ..> TIERS : "miss -> candidates"
BILL ..> STORE

note right of DETECT
  Bench-gated at 90%
  `make bench` / CI run
  `go run . bench -target 90`
  over every tool-output shape;
  below the gate the build fails.
end note

note right of KEY
  Why canonical JSON?
  Whitespace and key order stop
  causing misses, and the
  `stream` field is excluded, so
  the same logical request always
  lands on the same entry.
end note

note right of LOOKUP
  Miss reasons, counted in
  routre_cache_misses_by_reason_total:
  disabled, absent, expired,
  shape_mismatch.
  The legacy
  routre_cache_misses_total
  is still exported.
end note

note bottom of STREAM
  Streaming and JSON never cross.
  One key can hold either shape,
  depending on how the first request
  arrived; a lookup serves only the
  matching kind, so a client asking
  for JSON is never handed SSE
  frames. A mid-stream abort is
  never stored.
end note

note right of COOL
  Per-provider isolation: one
  failing provider never cools
  another. Cooldown 5 min, not 30:
  a 60 s provider blip must not
  become a half-hour outage.
  doctor and /v1/status show the
  remaining time and class.
end note

note bottom of RUNNER2
  Honest errors.
  model_not_found only when no
  provider can serve the model.
  providers_unavailable when every
  capable provider is cooling, with a
  Retry-After worth believing.
  all_providers_failed carries the
  full attempts[] log.
end note

@enduml
